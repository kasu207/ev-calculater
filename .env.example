# Vorlage fuer den Serverbetrieb.
#
#   cp .env.example .env    und dann ausfuellen.
#
# Docker Compose liest .env automatisch aus diesem Verzeichnis. Die Datei
# enthaelt Zugangsdaten und steht deshalb in .gitignore - sie gehoert nie in
# die Versionsverwaltung.

# --- Pflicht -----------------------------------------------------------

# Die oeffentliche Adresse, unter der die Seite erreichbar ist, ohne
# abschliessenden Schraegstrich. Sie steht in sitemap.xml, in jedem
# canonical-Verweis, in geteilten Links und im Bestaetigungslink der Mail.
# Ist sie falsch, zeigen alle diese Verweise ins Leere.
SITE_URL=https://beispiel.de

# Zugang zur Kennzahlenseite unter /admin?token=...
# Erzeugen mit:  openssl rand -hex 24
# Hexadezimal statt Base64, damit das Token ohne Maskierung in eine Adresse
# passt. Ohne Token ist /admin abgeschaltet und antwortet wie eine
# unbekannte Seite.
ADMIN_TOKEN=

# --- Hinter einem Reverse Proxy ---------------------------------------

# Den Container nur lokal oeffnen, damit Port 7000 nicht aus dem Internet
# erreichbar ist. Ohne Reverse Proxy diese Zeile auskommentieren.
BIND_ADDR=127.0.0.1

# Wertet X-Forwarded-For aus, damit die Ratenbegrenzung die tatsaechliche
# Client-IP sieht statt der des Proxys. NUR setzen, wenn wirklich ein
# vertrauenswuerdiger Proxy davorsteht - andernfalls kann sich jeder Client
# seine IP selbst aussuchen und die Begrenzung umgehen.
TRUST_PROXY=1

# --- Mailversand ------------------------------------------------------

# Webhook eines Maildienstes, an den die Bestaetigungsmail als JSON geht
# (Brevo, Mailjet, n8n, Make - jeder eingehende Webhook genuegt).
# Ohne diese Angabe wird die Mail nur ins Log geschrieben. Das reicht zum
# Testen, aber jede Adresse bleibt dann unbestaetigt und damit unbrauchbar.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
