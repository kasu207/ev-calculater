{
  "name": "ampmatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ampmatch/web dev",
    "build": "pnpm --filter @ampmatch/web build",
    "start": "pnpm --filter @ampmatch/web start",
    "lint": "pnpm --filter @ampmatch/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ampmatch/core test",
    "test:e2e": "pnpm --filter @ampmatch/web test:e2e",
    "daten:pruefen": "pnpm --filter @ampmatch/core daten:pruefen"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
