# Nach /opt/ampmatch/.env kopieren und ausfuellen. Nicht ins Repository legen.

TAG=latest
GHCR_NAMESPACE=ampmatch

AMPMATCH_BASIS_URL=https://ampmatch.de

# Aus der Umami-Oberflaeche unter Einstellungen, Websites.
AMPMATCH_UMAMI_SKRIPT_URL=https://stats.ampmatch.de/script.js
AMPMATCH_UMAMI_WEBSITE_ID=

# Deep-Link-Adresse aus dem FlexOffers-Konto, ohne den Parameter url.
AMPMATCH_FLEXOFFERS_DEEPLINK_BASIS=
AMPMATCH_FLEXOFFERS_SUBID=ampmatch

# Pflichtangaben fuer Impressum und Datenschutz. Zeilen der Anschrift mit | trennen.
AMPMATCH_BETREIBER_NAME=
AMPMATCH_BETREIBER_ANSCHRIFT=
AMPMATCH_BETREIBER_EMAIL=
AMPMATCH_BETREIBER_TELEFON=
AMPMATCH_BETREIBER_USTID=

UMAMI_DB_PW=
UMAMI_SECRET=
